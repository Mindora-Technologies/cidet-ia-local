# =============================================================================
#  Assistent Distribucions Vallès — variables d'entorn
#
#     cp demo/.env.example demo/.env    i canvia el que calgui
#
#  El fitxer .env NO es puja mai al repositori (és al .gitignore).
# =============================================================================

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=distribuidora
POSTGRES_USER=postgres
# Contrasenya de l'usuari administrador. CANVIA-LA.
POSTGRES_PASSWORD=canvia_aquesta_contrasenya
POSTGRES_PORT=5432

# Cadena de connexió que fa servir l'agent. Fixa't que NO és l'usuari
# administrador: és el rol de només lectura, que només veu les vistes.
POSTGRES_DSN=postgresql://assistent_ro:canvia_aquesta_contrasenya@localhost:5432/distribuidora
# Sostre de files que retorna una consulta de l'agent.
SQL_MAX_ROWS=50

# ------------------------------------------------------------------ Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_COLLECTION=distribucions_valles

# ------------------------------------------------------------------ Ollama
# Ollama corre a l'amfitrió, que és qui té la GPU.
OLLAMA_URL=http://localhost:11434
# Model de xat. Ha de saber fer servir eines (tool calling).
OLLAMA_MODEL=qwen3:8b
# Model d'embeddings. Ha de ser EL MATEIX amb què s'ha fet la ingesta:
# si el canvies, cal tornar a executar ingest.py --reset.
EMBED_MODEL=qwen3-embedding:0.6b
# 0–0,3 per a assistents d'empresa. Aquí la creativitat és un defecte.
TEMPERATURE=0.1
# Límit de voltes del bucle d'eines, perquè un model encantat no s'hi quedi.
MAX_STEPS=6

# --------------------------------------------------------- API d'enviaments
SHIPMENTS_API_URL=http://localhost:8080
API_PORT=8080
# Clau d'API. CANVIA-LA: és l'única cosa que protegeix l'endpoint.
API_KEY=canvia_aquesta_clau
API_TIMEOUT=10
API_RETRIES=3

# Latència artificial en mil·lisegons. A la C6 es puja a 3000 per practicar
# timeouts i veure què passa quan una font externa va lenta.
FAKE_LATENCY_MS=0
# Proporció de peticions que fallen amb un 503 (0 = cap, 0.3 = una de cada tres).
# A la C6 es puja per practicar reintents amb espera exponencial.
FAILURE_RATE=0

# -------------------------------------------------------------- Open WebUI
WEBUI_PORT=3000
# false a l'aula perquè no calgui crear compte. A casa d'un client, true.
WEBUI_AUTH=false

# ------------------------------------------------------------------ Agent
AGENT_PORT=8000
